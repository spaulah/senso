# Senso configuration template. Placeholders only - never commit real values.
# Set these as environment variables (or in the "env" block of your MCP client config).
# Nested settings use a double underscore: Senso:Vision:Key -> Senso__Vision__Key

# --- OCR: Azure AI Vision (Image Analysis 4.0, Read) ---------------------------
Senso__Vision__Endpoint=https://<your-vision-resource>.cognitiveservices.azure.com
Senso__Vision__Key=<your-vision-key>

# --- Speech: Azure OpenAI audio transcription deployment -----------------------
# Full URL of YOUR deployment, including the api-version your resource supports.
Senso__Speech__Endpoint=https://<your-openai-resource>.openai.azure.com/openai/deployments/<your-deployment>/audio/transcriptions?api-version=<api-version>
Senso__Speech__Key=<your-openai-key>
# Optional (defaults shown)
# Senso__Speech__Model=gpt-4o-transcribe-diarize
# Senso__Speech__ResponseFormat=diarized_json
# Senso__Speech__ChunkingStrategy=auto

# --- Limits (optional, defaults shown) -----------------------------------------
# Senso__Limits__MaxImageSizeMb=20
# Senso__Limits__MaxAudioSizeMb=25
# Senso__Limits__DefaultTimeoutSeconds=120
# Senso__Limits__MaxTimeoutSeconds=900

# --- File access (optional but recommended) ------------------------------------
# Restrict file inputs to these directories. Index 0, 1, 2, ... for more than one.
# Senso__AllowedDirectories__0=/Users/me/Documents/senso-inbox
